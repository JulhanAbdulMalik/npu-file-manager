generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String    @id @default(cuid())
  name       String
  email      String    @unique
  password   String
  role       Role      @default(ADMIN)
  kategoriId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  kategori   Kategori? @relation(fields: [kategoriId], references: [id])
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

model Kategori {
  id          String        @id @default(cuid())
  nama        String
  deskripsi   String?
  warna       String?       @default("#a80063")
  ikon        String?
  urutan      Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  subKategori SubKategori[]
  admins      User[]
}

model SubKategori {
  id          String    @id @default(cuid())
  nama        String
  deskripsi   String?
  urutan      Int       @default(0)
  kategoriId  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  kategori    Kategori  @relation(fields: [kategoriId], references: [id], onDelete: Cascade)
  dokumen     Dokumen[]
}

model Dokumen {
  id            String      @id @default(cuid())
  nama          String
  deskripsi     String?
  linkDrive     String
  driveFileId   String?
  status        StatusDok   @default(BELUM)
  urutan        Int         @default(0)
  subKategoriId String
  uploadedById  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  subKategori   SubKategori @relation(fields: [subKategoriId], references: [id], onDelete: Cascade)
}

enum StatusDok {
  LENGKAP
  DALAM_PROSES
  BELUM
}
